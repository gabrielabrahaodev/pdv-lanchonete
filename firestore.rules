rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function membro(rid) {
      return get(/databases/$(database)/documents/restaurantes/$(rid)/data/usuarios/items/$(request.auth.uid)).data;
    }
    function ativo(rid) {
      return request.auth != null
        && request.auth.token.restaurantId == rid
        && membro(rid).ativo == true;
    }
    function financeiro(rid) {
      return ativo(rid) && membro(rid).papel in ['admin', 'gerente', 'caixa'];
    }
    match /onboarding/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
    }
    match /restaurantes/{rid} {
      allow get: if ativo(rid);
      match /data/configuracoes {
        allow get: if ativo(rid);
      }
      match /data/{colecao}/items/{id} {
        allow read: if ativo(rid) && (
          colecao in ['mesas', 'pedidos', 'produtos', 'categorias', 'imagens',
                      'estoque', 'movimentacoes_estoque', 'delivery_orders']
          || (colecao in ['despesas', 'fornecedores', 'sessoes_caixa',
                          'agregados_diarios', 'agregados_mensais', 'agregados_meta'] && financeiro(rid))
          || (colecao == 'usuarios' && (id == request.auth.uid || financeiro(rid)))
        );
      }
    }
    // Escritas diretas e coleções internas de eventos: negadas por padrão.
  }
}
